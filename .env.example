# Copie este arquivo para ".env" e preencha com sua chave da Groq.

# Chave gratuita: https://console.groq.com/keys
GROQ_API_KEY=sua_chave_groq_aqui

# Modelo de chat usado na Groq (veja modelos disponíveis em https://console.groq.com/docs/models)
GROQ_MODEL=llama-3.3-70b-versatile

# Modelo de embeddings local (baixado automaticamente na primeira execução, sem custo)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Parâmetros do RAG (opcionais, já têm valores padrão sensatos)
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
