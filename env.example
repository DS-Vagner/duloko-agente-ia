# Copie este arquivo para ".env" e preencha com os valores da sua conta OCI.

# Perfil definido em ~/.oci/config (normalmente "DEFAULT")
OCI_CONFIG_PROFILE=DEFAULT

# OCID do compartment onde o Generative AI está habilitado
# Encontre em: OCI Console > Identity > Compartments
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Endpoint do serviço Generative AI Inference na sua região
# Exemplo para a região us-chicago-1 (uma das regiões com o serviço disponível)
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com

# IDs dos modelos gerenciados usados pelo agente
# Consulte os modelos disponíveis na sua região em OCI Console > Analytics & AI > Generative AI
EMBED_MODEL_ID=cohere.embed-multilingual-v3.0
CHAT_MODEL_ID=meta.llama-3.1-70b-instruct

# Parâmetros do RAG (opcionais, já têm valores padrão sensatos)
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
